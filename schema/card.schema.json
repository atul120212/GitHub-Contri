{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContributorCard",
  "description": "Schema definition for an open source contributor profile card",
  "type": "object",
  "required": ["name", "github", "bio", "skills"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50,
      "description": "Your full name or display name"
    },
    "github": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$",
      "minLength": 1,
      "maxLength": 39,
      "description": "Your GitHub username (without @)"
    },
    "avatar": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://.+",
      "description": "Direct image URL for your avatar (e.g. https://github.com/<username>.png)"
    },
    "bio": {
      "type": "string",
      "minLength": 5,
      "maxLength": 180,
      "description": "Short bio or intro (max 180 characters)"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
      },
      "description": "Technologies, languages, or tools you are learning or use (1-12 tags)"
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portfolio": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://.+"
        },
        "linkedin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://(www\\.)?linkedin\\.com/.+"
        },
        "twitter": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://(www\\.)?(twitter\\.com|x\\.com)/.+"
        },
        "blog": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://.+"
        },
        "youtube": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://.+"
        }
      },
      "description": "Optional social and personal links (valid HTTPS URLs)"
    },
    "firstPR": {
      "type": "string",
      "maxLength": 60,
      "description": "A note or PR reference (e.g., 'joined via PR #42')"
    },
    "joinedDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date joined in YYYY-MM-DD format"
    }
  }
}
