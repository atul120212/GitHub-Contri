{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/validate-cards.js && npm --prefix site run build",
  "outputDirectory": "site/dist",
  "installCommand": "npm --prefix site install",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
